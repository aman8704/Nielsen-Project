<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ConductorCompanion" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_inverse</item>
        <item name="colorSecondary">@color/success</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Typography -->
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Conductor.Body</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Conductor.Fare</item>
    </style>

    <style name="TextAppearance.Conductor.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Conductor.Fare" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_fare_total</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
</resources>